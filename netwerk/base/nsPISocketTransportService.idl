#include "nsISocketTransportService.idl"

%{C++
#include "sslt.h"
%}

[ref] native SSLReadinessRef(const SSLReadiness);

/**
 * This is a private interface used by the internals of the networking library.
 * It will never be frozen.  Do not use it in external code.
 */
[builtinclass, scriptable, uuid(18f73bf1-b35b-4b7b-aa9a-11bcbdbc389c)]
interface nsPISocketTransportService : nsIRoutedSocketTransportService
{
  /**
   * init/shutdown routines.
   */
  void init();
  void shutdown(in boolean aXpcomShutdown);

  /**
   * controls the TCP sender window clamp
   */
  readonly attribute long sendBufferSize;

  /**
   * Controls whether the socket transport service is offline.
   * Setting it offline will cause non-local socket detachment.
   */
  attribute boolean offline;

  /**
   * Controls the default timeout (in seconds) for sending keepalive probes.
   */
  readonly attribute long keepaliveIdleTime;

  /**
   * Controls the default interval (in seconds) between retrying keepalive probes.
   */
  readonly attribute long keepaliveRetryInterval;

  /**
   * Controls the default retransmission count for keepalive probes.
   */
  readonly attribute long keepaliveProbeCount;

  /**
   * Swaps the native OS handles underneath aFd1/aFd2 (like
   * PR_ChangeFileDescNativeHandle, which this calls), while keeping any
   * poller registration for either fd's *original* native handle in sync
   * with the swap. Callers that mutate a PRFileDesc's native handle in place
   * (e.g. nsSOCKSIOLayer's address-family fixup) while either fd may already
   * be registered with the socket transport service's poller (i.e. its
   * transport is already connecting/connected) must use this instead of
   * calling PR_ChangeFileDescNativeHandle directly.
   */
  [noscript] void changeFileDescNativeHandleWithPoller(in PRFileDescPtr aFd1,
                                                        in PRFileDescPtr aFd2);

  /**
   * Called by NSSSocketControl (via NSS's SSL_SetReadinessCallback) whenever
   * a TLS socket's OS-level interest, buffered-plaintext readiness, or
   * async-pause state changes. aReadiness is NSS's own SSLReadiness struct,
   * passed straight through -- kept as four distinct read/write-direction
   * booleans rather than two OS-interest bits, since ssl_Poll() can
   * cross-map a logical direction onto the other kernel direction (e.g.
   * mid-handshake, a logical read may need to wait for the kernel socket to
   * become writable instead), and collapsing this would make it impossible
   * to tell, once the shared kernel event fires, which logical direction(s)
   * it satisfies. Registers aFd's poller-backend interest directly from
   * those four booleans (no per-iteration layer walk needed for this fd
   * from here on) and adds/removes it from the ready-now list based on
   * aReadiness.plaintextReady. A no-op if the legacy PR_Poll path is active
   * (NSS should never register this callback in that mode) or if aFd is not
   * currently attached.
   */
  [noscript] void onTLSReadinessChanged(in PRFileDescPtr aFd,
                                        in SSLReadinessRef aReadiness);
};
